# 至少填一个 AI 服务的 key（两个都填时，网页上会出现“AI 服务”选择）
OPENAI_API_KEY=
GEMINI_API_KEY=

# 默认使用哪个服务：openai 或 gemini
AI_PROVIDER=openai

# 模型名称（服务商改名时在这里改）
OPENAI_MODEL=gpt-image-2
OPENAI_QUALITY=medium
GEMINI_MODEL=gemini-3.1-flash-image

# 访问口令：设置后，网页要输入这个口令才能用，防止别人消耗你的额度。强烈建议设置。
APP_PASSCODE=

# 每个 IP 每小时最多画几张
RATE_LIMIT_PER_HOUR=30

# 部署在 Render、Railway、Fly.io 等反向代理后面时设为 1，按真实访客 IP 限流
TRUST_PROXY=
PORT=8787
